---
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Sovereign Voice vs. The Competition',
  description: 'See how Sovereign Voice stacks up against other solutions.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Sovereign Voice"
    title="How We Compare"
    subtitle="Sovereign Voice is built on a modern stack to deliver a superior experience. See how we stack up against the competition."
  />

  <Content
    id="comparison"
    title="Sovereign Voice vs. The Competition"
    subtitle="A side-by-side look at the features that matter most."
  >
    <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
      <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
          <tr>
            <th scope="col" class="px-6 py-3">
              Feature
            </th>
            <th scope="col" class="px-6 py-3">
              Sovereign Voice
            </th>
            <th scope="col" class="px-6 py-3">
              Generic AI
            </th>
            <th scope="col" class="px-6 py-3">
              Legacy IVR
            </th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
              Response Time
            </th>
            <td class="px-6 py-4">
              &lt;800ms
            </td>
            <td class="px-6 py-4">
              2-5 seconds
            </td>
            <td class="px-6 py-4">
              N/A
            </td>
          </tr>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
              Barge-In
            </th>
            <td class="px-6 py-4">
              Yes
            </td>
            <td class="px-6 py-4">
              Limited
            </td>
            <td class="px-6 py-4">
              No
            </td>
          </tr>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
              PII Scrubbing
            </th>
            <td class="px-6 py-4">
              Yes
            </td>
            <td class="px-6 py-4">
              No
            </td>
            <td class="px-6 py-4">
              No
            </td>
          </tr>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
              CRM Integration
            </th>
            <td class="px-6 py-4">
              Bi-directional
            </td>
            <td class="px-6 py-4">
              Limited
            </td>
            <td class="px-6 py-4">
              No
            </td>
          </tr>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
              Data Sovereignty
            </th>
            <td class="px-6 py-4">
              Yes
            </td>
            <td class="px-6 py-4">
              No
            </td>
            <td class="px-6 py-4">
              N/A
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </Content>
</Layout>
